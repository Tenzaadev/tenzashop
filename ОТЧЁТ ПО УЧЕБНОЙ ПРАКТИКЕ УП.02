            z-index: 100;
        }
        .logo { font-size: 24px; font-weight: 900; color: #ccff00; text-decoration: none; }
        .nav { display: flex; gap: 20px; }
        .nav a { color: #999; text-decoration: none; font-size: 14px; }
        .nav a:hover { color: #fff; }
        .icons { display: flex; gap: 10px; }
        .icons button {
            width: 40px; height: 40px;
            border-radius: 50%;
            background: #1a1a1a;
            border: 1px solid #333;
            color: #999;
            cursor: pointer;
            font-size: 16px;
        }
        .icons button:hover { border-color: #ccff00; color: #fff; }
        
        /* Главный экран */
        .hero {
            text-align: center;
            padding: 100px 20px;
            background: linear-gradient(180deg, #0a0a0a, #111);
        }
        .hero h1 { font-size: 48px; margin-bottom: 16px; }
        .hero h1 span { color: #ccff00; }
        .hero p { color: #999; font-size: 18px; margin-bottom: 32px; }
        .btn {
            padding: 14px 32px;
            border-radius: 50px;
            font-weight: 700;
            text-decoration: none;
            font-size: 16px;
            border: none;
            cursor: pointer;
            display: inline-block;
        }
        .btn-primary { background: #ccff00; color: #000; }
        .btn-primary:hover { background: #fff; }
        .btn-outline { background: transparent; color: #fff; border: 2px solid #333; margin-left: 12px; }
        .btn-outline:hover { border-color: #ccff00; }
        
        /* Сетка товаров */
        .products {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }
        .products h2 { font-size: 28px; margin-bottom: 24px; }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
        }
        .card {
            background: #111;
            border: 1px solid #222;
            border-radius: 16px;
            overflow: hidden;
            transition: 0.3s;
        }
        .card:hover { border-color: #ccff00; transform: translateY(-4px); }
        .card-img {
            height: 280px;
            background: linear-gradient(135deg, #1a1a1a, #222);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 64px;
        }
        .card-body { padding: 16px; }
        .card-brand { color: #666; font-size: 12px; text-transform: uppercase; }
        .card-title { font-weight: 700; margin: 4px 0; font-size: 16px; }
        .card-price { color: #ccff00; font-weight: 700; font-size: 18px; }
        .card-price-old { color: #555; text-decoration: line-through; font-size: 14px; margin-left: 8px; }
        .sizes { display: flex; gap: 6px; margin: 10px 0; }
        .size {
            width: 32px; height: 32px;
            border-radius: 8px;
            background: #1a1a1a;
            border: 1px solid #333;
            color: #999;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .size.active { background: #ccff00; color: #000; border-color: #ccff00; }
        .btn-cart {
            width: 100%;
            padding: 12px;
            border-radius: 12px;
            background: #ccff00;
            color: #000;
            font-weight: 700;
            border: none;
            cursor: pointer;
            font-size: 14px;
            margin-top: 8px;
        }
        .btn-cart:hover { background: #fff; }
        
        /* Подвал */
        .footer {
            text-align: center;
            padding: 40px 20px;
            border-top: 1px solid #222;
            color: #555;
            font-size: 14px;
            margin-top: 60px;
        }
        
        /* Адаптивность */
        @media (max-width: 768px) {
            .nav { display: none; }
            .hero h1 { font-size: 32px; }
            .grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 480px) {
            .grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
